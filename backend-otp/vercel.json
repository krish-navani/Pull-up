{
  "buildCommand": "cd backend && npm install --include=dev && npm run build",
  "outputDirectory": "backend/dist",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/[...route].js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route].js"
    }
  ]
}
