# Environment Configuration
NODE_ENV=production
PORT=3000

# Firebase Configuration (Required)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key-with-escaped-newlines
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Email Configuration (Required)
MAIL_SERVICE=gmail
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password-not-account-password
MAIL_FROM_NAME=PullUp

# OTP Configuration (Optional - defaults provided)
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5

# Rate Limiting Configuration (Optional - defaults provided)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# CORS Configuration (Optional - defaults to *)
CORS_ORIGIN=*

# University Domain Suffix (Optional)
UNIVERSITY_DOMAIN=@atlasskilltech.university
