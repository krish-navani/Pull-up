rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getPersistentUserId() {
      return request.auth != null ? 
             (exists(/databases/$(database)/documents/userSessions/$(request.auth.uid)) ?
              get(/databases/$(database)/documents/userSessions/$(request.auth.uid)).data.userId :
              request.auth.uid) : 
             null;
    }

    function isCarpoolDriver(rideId) {
      return exists(/databases/$(database)/documents/rides/$(rideId)) && 
             getPersistentUserId() == get(/databases/$(database)/documents/rides/$(rideId)).data.driverId;
    }

    function isTaxiCreator(rideId) {
      return exists(/databases/$(database)/documents/taxiPools/$(rideId)) && 
             getPersistentUserId() == get(/databases/$(database)/documents/taxiPools/$(rideId)).data.creatorId;
    }

    function isPaidCarpoolPassenger(rideId) {
      return exists(/databases/$(database)/documents/bookings/$(rideId + "_" + getPersistentUserId())) && 
             get(/databases/$(database)/documents/bookings/$(rideId + "_" + getPersistentUserId())).data.status == 'confirmed' && 
             get(/databases/$(database)/documents/bookings/$(rideId + "_" + getPersistentUserId())).data.paymentStatus == 'paid';
    }

    function isTaxiPoolMember(rideId) {
      return exists(/databases/$(database)/documents/poolMembers/$(rideId + "_" + getPersistentUserId()));
    }

    function canAccessChat(rideId) {
      return isSignedIn() && 
             (!exists(/databases/$(database)/documents/rides/$(rideId)) || get(/databases/$(database)/documents/rides/$(rideId)).data.status != 'cancelled') &&
             (!exists(/databases/$(database)/documents/taxiPools/$(rideId)) || get(/databases/$(database)/documents/taxiPools/$(rideId)).data.status != 'CANCELLED') &&
             (
               isCarpoolDriver(rideId) || 
               isTaxiCreator(rideId) || 
               isPaidCarpoolPassenger(rideId) || 
               isTaxiPoolMember(rideId)
             );
    }

    function isChatWritable(rideId) {
      return (!exists(/databases/$(database)/documents/rides/$(rideId)) || 
              (
                get(/databases/$(database)/documents/rides/$(rideId)).data.status != 'completed' &&
                get(/databases/$(database)/documents/rides/$(rideId)).data.status != 'cancelled' &&
                get(/databases/$(database)/documents/rides/$(rideId)).data.status != 'expired' &&
                get(/databases/$(database)/documents/rides/$(rideId)).data.status != 'no_show'
              )) &&
             (!exists(/databases/$(database)/documents/taxiPools/$(rideId)) || 
              (
                get(/databases/$(database)/documents/taxiPools/$(rideId)).data.status != 'completed' &&
                get(/databases/$(database)/documents/taxiPools/$(rideId)).data.status != 'CANCELLED' &&
                get(/databases/$(database)/documents/taxiPools/$(rideId)).data.status != 'expired'
              ));
    }

    function isPublicProfileShape(data, userId) {
      return data.keys().hasOnly([
               'id', 'fullName', 'profileImage', 'role', 'course', 'year',
               'division', 'licenseVerified', 'rating', 'completedRides', 'status', 'lastSeen',
               'createdAt', 'updatedAt'
             ]) &&
             data.id == userId;
    }

    // ─── OTP Verification ───────────────────────────────────────────────────
    // Must be accessible before authentication (signup / login flow)
    // Locked down client-side; only backend Admin SDK has read/write privileges.
    match /otpVerification/{document=**} {
      allow read, write: if false;
    }

    // ─── User Session Mappings ──────────────────────────────────────────────
    match /userSessions/{sessionId} {
      allow read, write: if isSignedIn() && request.auth.uid == sessionId;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && getPersistentUserId() == userId;

      // Identity is created by the backend from the verified university email.
      allow create: if false;
      allow update: if isSignedIn() && getPersistentUserId() == userId &&
                    request.resource.data.id == resource.data.id &&
                    request.resource.data.email == resource.data.email &&
                    request.resource.data.fullName == resource.data.fullName;
      allow delete: if isSignedIn() && getPersistentUserId() == userId;

      // ── Notifications subcollection ──────────────────────────────────────
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() && getPersistentUserId() == userId;
        allow create: if isSignedIn(); // Fallback client-side notifications write
      }
    }

    // Sanitized identity used by ride, booking and chat surfaces.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() &&
                       getPersistentUserId() == userId &&
                       isPublicProfileShape(request.resource.data, userId) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.fullName == resource.data.fullName;
      allow delete: if isSignedIn() && getPersistentUserId() == userId;
    }

    // ─── Rides ──────────────────────────────────────────────────────────────
    // NOTE: queries that combine `where status in [...]` + `orderBy departureTime`
    // require a composite index. To avoid index errors (which surface as
    // permission-denied), sorting is done client-side in rideService.ts.
    match /rides/{rideId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.driverId == getPersistentUserId();
      allow update: if isSignedIn() && (
        resource.data.driverId == getPersistentUserId() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedSeats', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (
        resource.data.driverId == getPersistentUserId() ||
        resource.data.status == 'expired' ||
        resource.data.status == 'completed' ||
        resource.data.status == 'cancelled'
      );
    }

    // ─── Bookings ───────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource == null || resource.data.passengerId == getPersistentUserId() || resource.data.driverId == getPersistentUserId());
      allow create: if false; // Authoritative fare bookings are created by the backend only.
      // Passengers can cancel; drivers can accept/reject or update transit states (pickedUp, droppedOff, status)
      allow update: if isSignedIn() &&
                       request.resource.data.fare == resource.data.fare &&
                       request.resource.data.fareStatus == resource.data.fareStatus &&
                       request.resource.data.totalPrice == resource.data.totalPrice &&
                       (
                         (getPersistentUserId() == resource.data.passengerId && request.resource.data.status == 'cancelled') ||
                         (getPersistentUserId() == resource.data.driverId)
                       );
      allow delete: if false;
    }

    // ─── Chat Rooms + Messages ───────────────────────────────────────────────
    match /chatRooms/{rideId} {
      allow read: if canAccessChat(rideId);
      allow create: if canAccessChat(rideId) &&
                       getPersistentUserId() in request.resource.data.participants;
      allow update: if canAccessChat(rideId) &&
                       request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canAccessChat(rideId);
        allow create: if canAccessChat(rideId) &&
                         request.resource.data.rideId == rideId &&
                         request.resource.data.senderId == getPersistentUserId();
        allow update: if canAccessChat(rideId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'content', 'timestamp']);
        allow delete: if false;
      }
    }

    // ─── Ride Group Chats ──────────────────────────────────────────────────
    match /rideChats/{rideId} {
      // Collection listeners constrain participants with array-contains.
      allow read: if isSignedIn() &&
                     getPersistentUserId() in resource.data.participants;
      allow create: if isSignedIn() && (isCarpoolDriver(rideId) || isTaxiCreator(rideId));
      allow update: if isSignedIn() && (
        isCarpoolDriver(rideId) || 
        isTaxiCreator(rideId) || 
        (
          canAccessChat(rideId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageTime', 'lastMessageSenderId', 'lastMessageSenderName', 'updatedAt'])
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
                       getPersistentUserId() in
                         get(/databases/$(database)/documents/rideChats/$(rideId)).data.participants;
        allow create: if canAccessChat(rideId) && isChatWritable(rideId);
        allow update, delete: if false;
      }
    }

    // ─── Legacy Chats (kept for backward compat) ────────────────────────────
    match /chats/{rideId} {
      allow read: if canAccessChat(rideId);
      allow create: if canAccessChat(rideId) &&
                       getPersistentUserId() in request.resource.data.participants;
      allow update: if canAccessChat(rideId) &&
                       request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canAccessChat(rideId);
        allow create: if canAccessChat(rideId) &&
                         request.resource.data.rideId == rideId &&
                         request.resource.data.senderId == getPersistentUserId();
        allow update, delete: if false;
      }
    }

    // ─── Taxi Pools ─────────────────────────────────────────────────────────
    // NOTE: queries filter by status only (no composite index needed).
    // Client-side sorting avoids composite index requirements.
    match /taxiPools/{poolId} {
      allow read:   if isSignedIn();
      allow create: if false; // Backend creates route-priced Taxi Pools.
      allow update: if isSignedIn() &&
        request.resource.data.price == resource.data.price &&
        request.resource.data.pricing == resource.data.pricing &&
        request.resource.data.route == resource.data.route && (
          resource.data.creatorId == getPersistentUserId() ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'status', 'currentLocation', 'updatedAt'])
        );
      allow delete: if isSignedIn() && (
        resource.data.creatorId == getPersistentUserId() ||
        resource.data.status == 'expired' ||
        resource.data.status == 'completed' ||
        resource.data.status == 'CANCELLED'
      );
    }

    // ─── Pool Members ───────────────────────────────────────────────────────
    match /poolMembers/{memberId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.passengerId == getPersistentUserId() ||
        (
          exists(/databases/$(database)/documents/taxiPools/$(request.resource.data.poolId)) && 
          getPersistentUserId() == get(/databases/$(database)/documents/taxiPools/$(request.resource.data.poolId)).data.creatorId
        )
      );
      allow update, delete: if isSignedIn() && (
        resource.data.passengerId == getPersistentUserId() ||
        (
          exists(/databases/$(database)/documents/taxiPools/$(resource.data.poolId)) && 
          getPersistentUserId() == get(/databases/$(database)/documents/taxiPools/$(resource.data.poolId)).data.creatorId
        )
      );
    }

    // ─── Pool Requests ──────────────────────────────────────────────────────
    match /poolRequests/{requestId} {
      allow read:   if isSignedIn() && (
        resource == null || 
        resource.data.passengerId == getPersistentUserId() || 
        (
          exists(/databases/$(database)/documents/taxiPools/$(resource.data.poolId)) && 
          getPersistentUserId() == get(/databases/$(database)/documents/taxiPools/$(resource.data.poolId)).data.creatorId
        )
      );
      allow create: if false; // Backend creates fare-locked Taxi Pool requests.
      allow update: if isSignedIn() &&
        request.resource.data.fare == resource.data.fare &&
        request.resource.data.fareStatus == resource.data.fareStatus &&
        request.resource.data.totalPrice == resource.data.totalPrice && (
        resource.data.passengerId == getPersistentUserId() ||
        (
          exists(/databases/$(database)/documents/taxiPools/$(resource.data.poolId)) && 
          getPersistentUserId() == get(/databases/$(database)/documents/taxiPools/$(resource.data.poolId)).data.creatorId
        )
      );
      allow delete: if isSignedIn() && resource.data.passengerId == getPersistentUserId();
    }

    // ─── Wallets ────────────────────────────────────────────────────────────
    match /wallets/{userId} {
      allow read: if isSignedIn() && getPersistentUserId() == userId;
      allow write: if false; // Only written/updated by backend
    }

    // ─── Wallet Transactions ────────────────────────────────────────────────
    match /walletTransactions/{txId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == getPersistentUserId());
      allow write: if false; // Only written/updated by backend
    }

    // ─── Withdrawals ────────────────────────────────────────────────────────
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == getPersistentUserId());
      allow write: if false; // Only written/updated by backend
    }

  }
}
