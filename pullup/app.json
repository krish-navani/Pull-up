{
  "expo": {
    "name": "PullUp!",
    "slug": "PullUp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pullup",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow PullUp to take a profile photo or photograph a driving licence for verification.",
        "NSPhotoLibraryUsageDescription": "Allow PullUp to choose a profile photo or driving licence image for verification.",
        "NSLocationWhenInUseUsageDescription": "Allow PullUp to use your precise location while choosing pickup points and navigating an active ride.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow PullUp to share your location in the background only while an active ride is being tracked."
      },
      "bundleIdentifier": "com.pullupapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6C4A1",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.pullupapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PullUp to access your location even when the app is in the background.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#D4500A",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withReanimatedWorkletsBuildFix",
      "./plugins/withRazorpayAndroidFix",
      "./plugins/withNotificationFix",
      "./plugins/withGoogleMapsGradleEnv"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58d3a18c-0e66-4eff-81d3-a71eb775b788"
      }
    },
    "owner": "xnshikaa"
  }
}
